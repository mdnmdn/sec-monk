{
  "schema": "secmonk-module/1",
  "name": "py-procmon",
  "version": "0.1.0",
  "kind": "engine",
  "runtime": "python",
  "protocol": "secmonk-wire/1",
  "description": "Process monitor state (snapshot, watch) for the Processes views; prototype exception: reads this machine and matches read-only",
  "provides": {
    "methods": [
      "procmon.payload",
      "procmon.watch",
      "procmon.inventory"
    ]
  },
  "capabilities": [
    "local-system",
    "run-commands",
    "db-read",
    "stateful"
  ],
  "platforms": [
    "macos",
    "linux"
  ],
  "python": {
    "project": "python",
    "env": "secmonk-modules",
    "requires_python": ">=3.12,<3.14",
    "entry": [
      "-I",
      "-m",
      "secmonk_modules",
      "serve",
      "--stdio",
      "--module",
      "py-procmon"
    ]
  },
  "lifecycle": {
    "start": "lazy",
    "idle_timeout_s": 0,
    "max_restarts": 3,
    "restart_window_s": 60
  },
  "limits": {
    "hello_timeout_s": 20,
    "request_timeout_s": 300,
    "cancel_grace_s": 5,
    "max_frame": 16777216,
    "max_inflight": 1
  }
}
