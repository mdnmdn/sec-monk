{
  "schema": "secmonk-module/1",
  "name": "py-engine",
  "version": "0.1.0",
  "kind": "engine",
  "runtime": "python",
  "protocol": "secmonk-wire/1",
  "description": "classify, match, versions, scoring and report payloads",
  "provides": {
    "methods": [
      "engine.classify",
      "engine.match",
      "versions.compare",
      "versions.in_range",
      "versions.first_fixed",
      "versions.scheme",
      "scoring.priority",
      "reports.overview",
      "reports.assets",
      "reports.asset_detail",
      "reports.unmatched",
      "reports.findings",
      "reports.vuln_detail",
      "reports.vuln_search",
      "reports.status",
      "reports.sbom"
    ]
  },
  "capabilities": [
    "db-read"
  ],
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "python": {
    "project": "python",
    "env": "secmonk-modules",
    "requires_python": ">=3.12,<3.14",
    "entry": [
      "-I",
      "-m",
      "secmonk_modules",
      "serve",
      "--stdio",
      "--module",
      "py-engine"
    ]
  },
  "lifecycle": {
    "start": "eager",
    "idle_timeout_s": 0,
    "max_restarts": 3,
    "restart_window_s": 60
  },
  "limits": {
    "hello_timeout_s": 20,
    "request_timeout_s": 600,
    "cancel_grace_s": 5,
    "max_frame": 16777216,
    "max_inflight": 4
  }
}
