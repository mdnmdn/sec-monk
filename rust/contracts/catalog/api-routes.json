      "errors": [
        {
          "status": 400,
          "code": null,
          "when": "invalid body, forbidden browser option"
        },
        {
          "status": 403,
          "code": null,
          "when": "actions disabled (HTTP binding on a non-loopback address)"
        },
        {
          "status": 409,
          "code": null,
          "when": "a job is running; scan without save and no database"
        },
        {
          "status": 413,
          "code": null,
          "when": "body over 64 KiB"
        },
        {
          "status": 415,
          "code": null,
          "when": "Content-Type not application/json"
        }
      ]
    },
