{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.secmonk.invalid/engine/match.schema.json",
  "title": "engine.match params and result",
  "$defs": {
    "params": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "persisted"
            },
            "asset_id": {
              "type": "string"
            },
            "min_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "view_limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            }
          },
          "required": [
            "mode",
            "asset_id",
            "min_confidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "ephemeral"
            },
            "inventory": {
              "$ref": "../inventory/inventory.schema.json"
            },
            "min_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "view_limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            }
          },
          "required": [
            "mode",
            "inventory",
            "min_confidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "finding": {
      "type": "object",
      "properties": {
        "component_id": {
          "type": "integer"
        },
        "vuln_id": {
          "type": "string"
        },
        "advisory_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "fixed_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "cvss_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "epss": {
          "type": [
            "number",
            "null"
          ]
        },
        "kev": {
          "type": "boolean"
        },
        "priority": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4",
            null
          ]
        },
        "status": {
          "enum": [
            "open",
            "fixed",
            "suppressed"
          ]
        },
        "first_seen": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "triage": {
          "type": [
            "string",
            "null"
          ]
        },
        "triage_source": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "component_id",
        "vuln_id",
        "advisory_ids",
        "matched_by",
        "confidence",
        "kev",
        "priority",
        "status",
        "first_seen",
        "last_seen"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "persisted",
            "ephemeral"
          ]
        },
        "stats": {
          "$ref": "../api/match-stats.schema.json"
        },
        "based_on": {
          "type": "object",
          "properties": {
            "latest_scan_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "mirror_synced_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "latest_scan_id"
          ]
        },
        "finding_set": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "view": {
          "type": "array",
          "items": {
            "$ref": "../api/finding-row.schema.json"
          }
        }
      },
      "required": [
        "asset_id",
        "mode",
        "stats",
        "view"
      ],
      "additionalProperties": false
    }
  }
}
