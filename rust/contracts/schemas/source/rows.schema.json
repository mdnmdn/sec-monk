      "const": "rows"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "ops": {
      "type": "array",
