      "minItems": 1,
      "maxItems": 5000
    },
    "generation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$",
      "description": "Identity of the module's staging database (random, persisted; new when the file is recreated). Seqs compare only within one generation: the host never skips a batch of another generation and repairs from source.export instead. Optional: a module without staging omits it. A native source (rust ADR-0011) sends \"native-rust\" and no acked_through."
    },
    "acked_through": {
      "type": "integer",
      "minimum": 0,
      "description": "The highest seq the module had acknowledged for this source when it streamed the batch. Above the host's applied seq (or with no applied seq at all), the mirror lost rows the module already dropped from its log: the host repairs from source.export."
    }
  },
  "required": [
    "kind",
    "seq",
    "source",
    "ops"
  ],
