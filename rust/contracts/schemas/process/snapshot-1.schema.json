{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.secmonk.invalid/process/snapshot-1.schema.json",
  "title": "secmonk-process-snapshot/1",
  "description": "Writer contract of collectors/process/snapshot.py. Readers stay lenient (snapshot.from_dict: type checks, caps, re-redaction); unknown keys are ignored.",
