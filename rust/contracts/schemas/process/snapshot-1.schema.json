    },
    "host": {
      "type": "string"
    },
    "taken_at": {
      "type": "string"
    },
    "os": {
      "type": "object"
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "integer"
          },
          "ppid": {
            "type": [
              "integer",
              "null"
            ]
          },
          "uid": {
            "type": [
              "integer",
              "null"
            ]
          },
          "user": {
            "type": [
              "string",
              "null"
            ]
          },
          "exe": {
            "type": [
              "string",
              "null"
            ]
          },
          "started": {
            "type": [
              "string",
              "null"
            ]
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 64
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "cgroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "container": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "runtime": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "pod": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "pid"
        ]
      },
      "maxItems": 100000
    },
    "launch_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mechanism": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "program": {
            "type": [
              "string",
              "null"
            ]
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "run_at_load": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "keep_alive": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "disabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "meta": {
            "type": "object"
          }
        },
        "required": [
          "mechanism",
          "label"
        ]
      }
    },
    "executables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "exists": {
            "type": "boolean"
          },
          "size": {
            "type": "integer"
          },
          "mtime": {
            "type": "string"
