          },
          "quarantine": {
            "type": "object"
          },
          "where_froms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gatekeeper": {
            "type": "object"
          },
          "identity": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
