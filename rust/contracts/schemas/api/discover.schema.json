{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.secmonk.invalid/api/discover.schema.json",
  "title": "GET /api/discover (reports.discover_payload)",
  "type": "object",
  "properties": {
    "host": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "local",
            "ssh",
            "k8s"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "os_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "arch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "collector": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "selected": {
            "type": "boolean"
          },
          "details": {
            "type": [
              "object",
              "array"
            ]
          }
        },
        "required": [
          "id",
          "collector",
          "target",
          "options",
          "label",
          "description",
          "available",
          "reason",
          "selected",
          "details"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "host",
    "candidates",
    "warnings"
  ],
  "additionalProperties": false
}
