{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.secmonk.invalid/api/vuln-search-page.schema.json",
  "title": "GET /api/vulns/search",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "vuln_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "ecosystem": {
            "type": [
              "string",
              "null"
            ]
          },
          "vendor": {
            "type": [
              "string",
              "null"
            ]
          },
          "package": {
            "type": [
              "string",
              "null"
            ]
          },
          "product": {
            "type": [
              "string",
              "null"
            ]
          },
          "range_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "type": [
              "string",
              "null"
            ]
          },
          "cvss_score": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "vuln_id",
          "source",
          "range_type",
          "events",
          "versions"
        ]
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "limit_reached": {
      "type": "boolean"
    }
  },
  "required": [
    "results",
    "limit",
    "limit_reached"
  ],
  "additionalProperties": false
}
