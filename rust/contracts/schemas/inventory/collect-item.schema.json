{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.secmonk.invalid/inventory/collect-item.schema.json",
  "title": "collector.collect stream item (event.data)",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "asset"
        },
        "schema": {
          "const": "secmonk-inventory/1"
        },
        "collector": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "classified": {
          "const": false
        },
        "asset": {
          "$ref": "asset.schema.json"
        }
      },
      "required": [
        "kind",
        "schema",
        "collector",
        "classified",
        "asset"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "components"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "component.schema.json"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "kind",
        "components"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "warning"
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "additionalProperties": false
    }
  ]
}
